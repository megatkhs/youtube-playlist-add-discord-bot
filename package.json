{
  "name": "youtube-playlist-add-discord-bot",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "fix": "biome lint --apply ./src",
    "check": "biome check --apply ./src"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@types/node-cron": "^3.0.11",
    "bun-types": "latest",
    "prisma": "5.16.2"
  },
  "dependencies": {
    "@prisma/client": "5.16.2",
    "dayjs": "^1.11.10",
    "discord.js": "^14.14.1",
    "google-auth-library": "^9.7.0",
    "googleapis": "^126.0.1",
    "hono": "^3.12.12",
    "microcms-ts-sdk": "^1.1.0",
    "node-cron": "^3.0.3"
  },
  "engines": {
    "node": "18.18.0"
  }
}
