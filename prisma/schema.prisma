// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Discord サーバー
model Guild {
  id         String @id @default(cuid())
  originalId String @unique

  channels Channel[]
}

/// Discord チャンネル
model Channel {
  id         String  @id @default(cuid())
  originalId String  @unique
  guildId    String
  active     Boolean @default(true)

  // 設定など
  /// 月刊プレイリストを作成するか
  makeMonthlyPlaylist Boolean @default(false)
  /// ボットが起動した時の通知設定
  wakeUpNotification  Boolean @default(false)

  guild     Guild      @relation(fields: [guildId], references: [id])
  playlists Playlist[]
}

/// YoutubePlaylist
model Playlist {
  id                       String       @id @default(cuid())
  originalId               String       @unique
  type                     PlaylistType @default(Defalut)
  targetMonth              DateTime?
  channelId                String
  youtubeApiConfidentialId String

  channel                Channel                @relation(fields: [channelId], references: [id])
  youtubeApiConfidential YoutubeApiConfidential @relation(fields: [youtubeApiConfidentialId], references: [id])
}

enum PlaylistType {
  Defalut
  Monthly
}

model YoutubeApiConfidential {
  id           String   @id @default(cuid())
  access_token String   @unique
  scope        String
  token_type   String
  expiry_date  DateTime

  playlists Playlist[]
}
